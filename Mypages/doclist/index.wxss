/* Mypages/doclist/index.wxss */
.container {
  padding: 20rpx;
}

.board-item {
  padding: 10rpx;
  border-bottom: 1px solid #ccc;
}

.editor {
  margin-top: 20rpx;
}

textarea {
  width: 100%;
  height: 200rpx;
  border: 1px solid #ccc;
  margin-bottom: 20rpx;
}

.preview-image {
  width: 100%;
  height: auto;
  margin-bottom: 20rpx;
}

.popup-box {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.info-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  padding: 20rpx;
}

.row-info {
  margin-bottom: 20rpx;
}

.row-btn {
  display: flex;
  justify-content: space-between;
}

.left-btn, .right-btn {
  flex: 1;
  text-align: center;
  padding: 10rpx;
}

.left-btn {
  background-color: #ccc;
}

.right-btn {
  background-color: #007aff;
  color: #fff;
}
