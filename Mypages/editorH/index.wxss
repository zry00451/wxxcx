}
/* 公共提示样式 */
.swipe-hint {
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  max-width: 500rpx;
  animation: fadeIn 0.3s ease;
  z-index: 9999;
}

/* 左侧显示 */
.swipe-hint.left {
  left: 200rpx;
  text-align: left;
}

/* 右侧显示 */
.swipe-hint.right {
  right: 50rpx;
  text-align: right;
}

/* 逐步下移 */
.swipe-hint.step-1 {
  margin-top: -900rpx;
}

.swipe-hint.step-2 {
  margin-top: 0rpx;
}

.swipe-hint.step-3 {
  margin-top: 600rpx;
}
.arrow {
  font-size: 40rpx;
  color: rgba(247, 247, 247, 0.911);
  line-height: 1.6;
}
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

