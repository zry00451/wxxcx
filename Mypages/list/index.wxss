/* Mypages/list/index.wxss */
/* index.wxss */

.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

button {
  margin-bottom: 20rpx;
  background-color: #1aad19;
  color: #fff;
  border: none;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.log-item {
  background-color: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
}

.log-item text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.log-item button {
  margin-top: 8rpx;
  background-color: #e5e5e5;
  color: #333;
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
}
