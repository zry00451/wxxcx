/* Mypages/login/login.wxss */
/* 容器样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f2f2f2;
}

/* 用户信息样式 */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
}

.avatar {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  margin-bottom: 10px;
}

.nickname {
  font-size: 18px;
  color: #333;
}

/* 登录按钮样式 */
.login-btn, .logout-btn {
  width: 80%;
  padding: 12px;
  font-size: 16px;
  text-align: center;
  background-color: #007aff;
  color: white;
  border-radius: 8px;
  margin-top: 20px;
}

/* 退出按钮样式 */
.logout-btn {
  background-color: #ff3b30;
}
