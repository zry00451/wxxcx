/* Mypages/feedback/feedback.wxss */
/* 页面整体 */
.container {
  padding: 32rpx;
  background: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 标题 */
.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
  margin-bottom: 32rpx;
}

/* 文本输入框 */
.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f7f7f7;
  border-radius: 16rpx;
  box-sizing: border-box;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

/* 上传区域 */
.upload {
  margin-bottom: 32rpx;
}

/* 上传按钮 */
.upload button {
  width: 100%;
  background: #f0f0f0;
  color: #333333;
  font-size: 28rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
}

/* 图片列表 */
.img-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

/* 单张图片 */
.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: #eaeaea;
}

/* 联系方式输入框 */
.input {
  width: 100%;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333333;
  background: #f7f7f7;
  border-radius: 16rpx;
  box-sizing: border-box;
  margin-bottom: 48rpx;
}

/* 提交按钮 */
.submit {
  width: 100%;
  background: #07c160; /* 微信主色 */
  color: #ffffff;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 48rpx;
  text-align: center;
}

/* 按压反馈 */
.submit:active {
  opacity: 0.8;
}
