.main-btn {
  width: 100rpx;    
  display: flex;
  align-items: center;   /* 图标和文字垂直居中 */
  padding: 10rpx 20rpx;
  font-size: 32rpx;
  border-radius: 6rpx;
  
  background-color: #e1e2e45d; /* 可自定义 */
  color: rgba(0, 0, 0, 0.87);
}
/* 遮罩层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  z-index: 99;
}
/* 面板 */
.panel {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(2, 2, 2, 0.329);
  
  z-index: 30;
  text-align: center;
}
.fade-in {
  animation: fadeIn 0.5s forwards; /* 0.5秒渐显，保持最终状态 */
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
/* 动画 */
.anim-img {
  width: 100%;
  height: 100%;
  margin: 0 auto 30rpx;
}

/* 右侧窗口 */
.drawer {
  position: fixed;
  top: 0;
  right: 0;             /* 右侧拉出 */
  width: 100rpx;        /* 窗口宽度，可调 */
  height: 100%;
  background-color: rgba(255, 255, 255, 0);
  z-index: 100;
  box-shadow: -2rpx 0 10rpx rgba(0, 0, 0, 0);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;  /* 按钮垂直居中 */
  align-items: flex-start;  /* 按钮靠左显示 */
  gap: 20rpx;
}

/* 按钮容器，可选 */
.drawer-btns {
  position: absolute;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  width: 100%;
  top :1100rpx;
}

/* 按钮 */
.drawer-btn {
  width: 90%;           /* 按钮宽度小于窗口宽度 */
  text-align: left;     /* 文本靠左 */
  padding: 12rpx 10rpx;
  font-size: 32rpx;
  border-radius: 6rpx;
  background-color: #f0f0f000;
}