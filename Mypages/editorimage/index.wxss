.image-crop {
  position: relative;
  height: 100vh;
}
.add-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 360px;
  background: #f2f2f2;
}
.add-image {
  position: relative;
  width: 250px;
  height: 250px;
  margin: 20px auto 0;
  border-radius: 10px;
  border: 1px dashed #1f0416;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.crop-container {
 
  display: flex;
  justify-content: center;
  padding-top: 10px;
}
.crop-content {
  position: relative;
}
.pos-absolute {
  position: absolute;
 
}
.mask-bg {
  position: absolute;
  left: 0;
  top: 0;
  opacity: 0.6;
  background: rgba(22, 22, 22, 0);
}
.clip-path {
  /*clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);*/
  overflow: hidden;
  background: transparent;
  box-shadow: 0 0 0 4000rpx rgba(117, 113, 113, 0.5);
}

.corner-area {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0);
}
.left-top {
  border-top: 2px solid #696a74;
  border-left: 2px solid #696a74;
  left: -2px;
  top: -2px;
}
.right-top {
  border-top: 2px solid #696a74;
  border-right: 2px solid #696a74;
  right: -2px;
  top: -2px;
}
.right-bottom {
  border-bottom: 2px solid #696a74;
  border-right: 2px solid #696a74;
  right: -2px;
  bottom: -2px;
}
.left-bottom {
  border-bottom: 2px solid #696a74;
  border-left: 2px solid #696a74;
  left: -2px;
  bottom: -2px;
}

.confirm-area {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  border-top: 1px solid #ddd;
  border-bottom: 1px solid #ddd;
  margin-top: 20px;
  padding: 5px 0;
}
.cut-size {
  font-size: 12px;
  margin-left: 10px;
}
.cut-size-value {
  color: #575963;
}
.btn-cut {
  color: #4cae4c;
  padding: 3px;
  border: 1px solid #4cae4c;
  border-radius: 5px;
}
.done {
  margin-left: 20px;
  font-size: 14px;
}
.origin {
  position: absolute;
  right: 15px;
  font-size: 12px;
}

/* 固定在底部的按钮容器 */
.btn-operate-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
  padding: 30rpx 0;
  background:#f7f7f700 ;

  backdrop-filter: blur(10rpx);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0);
  z-index: 100;
}

.btn-operate-fixed .btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.btn-default {
  background: linear-gradient(135deg,#f7f7f7b7 0%,#00030ec9  100%);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(102, 126, 234, 0);
}

.btn-default:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 8rpx rgba(102, 126, 234, 0.3);
}


.main-canvas {
  position: fixed;
  top: -9999px;
  left: -9999px;
}
.placeholder {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}
/* 圆形裁剪框样式 */
.clip-path-circle {
  border-radius: 50%;
  overflow: hidden;
  border: 2rpx solid #fff;
  box-shadow: 0 0 0 4000rpx rgba(117, 113, 113, 0.5);
}

.clip-path-circle image {
  border-radius: 50%;
}

/* 圆形裁剪边框 */
.circle-clip-border {
  border: 2rpx solid rgb(245, 243, 243);
  border-radius: 50%;
  box-sizing: border-box;
}

/* 圆形缩放控制点 */
.circle-corner-area {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border: 4rpx solid #07c160;
  border-radius: 50%;
  right: -20rpx;
  bottom: -20rpx;
  z-index: 10;
}

/* 确保原有的矩形裁剪框样式不变 */
.clip-path {
  border: 2rpx solid #fff;
  overflow: hidden;
}



