/* Mypages/editorV/index.wxss */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.scroll-container {
  flex: 1;
  height: 100%;
}

.content-area {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-size: cover;
  background-repeat: no-repeat;
}

.draggable-item {
  position: absolute;
  cursor: move;
}

.content-image {
  width: 100px;
  height: 100px;
}


button {
  margin-bottom: 20rpx;
}
